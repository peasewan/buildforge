{
  "name": "wow-forever-paladin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.scripts.json && node --import tsx scripts/sync-class-static-pages.ts --check && vite build --configLoader runner && env TSX_TSCONFIG_PATH=tsconfig.scripts.json node --import tsx scripts/prerender-visual.ts && env TSX_TSCONFIG_PATH=tsconfig.scripts.json node --import tsx scripts/seo-validate.ts",
    "classes:sync": "tsx scripts/sync-class-static-pages.ts",
    "typecheck": "tsc -b && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "lint": "eslint .",
    "talents:diff": "tsx scripts/talents-diff.ts",
    "talents:diff:json": "tsx scripts/talents-diff.ts --json",
    "talents:validate": "tsx scripts/talents-validate.ts",
    "beta:changes:draft": "tsx scripts/beta-changes-draft.ts",
    "spellbook:validate": "tsx scripts/spellbook-validate.ts",
    "spellbook:query": "tsx scripts/spellbook-query.ts",
    "pipeline:simulate": "tsx scripts/release-simulate.ts",
    "analytics:report": "tsx scripts/analytics-report.ts",
    "talents:icons": "tsx scripts/download-talent-icons.ts",
    "seo:validate": "env TSX_TSCONFIG_PATH=tsconfig.scripts.json node --import tsx scripts/seo-validate.ts",
    "smoke:production": "node --import tsx scripts/post-deploy-smoke.ts",
    "emberville:validate": "node --import tsx scripts/emberville-data.ts --validate src/data/emberville-preview-2026-09-27.json",
    "emberville:query": "node --import tsx scripts/emberville-data.ts --query src/data/emberville-preview-2026-09-27.json",
    "emberville:diff": "node --import tsx scripts/emberville-data.ts --diff",
    "emberville:import": "node --import tsx scripts/emberville-data.ts --import"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "jsdom": "latest",
    "tsx": "^4.23.13",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vitest": "latest"
  }
}
